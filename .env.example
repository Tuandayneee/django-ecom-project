# Django core
DJANGO_SECRET_KEY=change-this-to-a-strong-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# Database: use 'sqlite' for quick local/test runs or 'mysql' for MySQL
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# MySQL settings (used when DB_ENGINE=mysql)
DB_NAME=urbanvibe_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Email SMTP (leave EMAIL_HOST_USER empty to log emails to console in dev)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# VNPay Sandbox / Production
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET_KEY=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:8000/orders/payment/return/

# Shipping / GHN (optional)
DEFAULT_SHIPPING_FEE=30000
GHN_TOKEN=
GHN_SHOP_ID=
GHN_API=https://online-gateway.ghn.vn/shiip/public-api/master-data

# Social Auth OAuth (Google / GitHub / Facebook) - Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

